{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhysicsMisconceptionDiagnosticBankV01",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "knowledge_db_version",
    "status",
    "group_count",
    "question_count",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "physics-misconception-diagnostic-bank"
    },
    "schema_version": {
      "type": "string"
    },
    "knowledge_db_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "group_count": {
      "type": "integer",
      "minimum": 1
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "concept_name",
          "diagnostic_goal",
          "misconceptions",
          "questions"
        ],
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "concept_name": {
            "type": "string"
          },
          "diagnostic_goal": {
            "type": "string"
          },
          "misconceptions": {
            "type": "array",
            "minItems": 1
          },
          "questions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4
          }
        }
      }
    }
  }
}
